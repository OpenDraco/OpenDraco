# Project artifact directories — checked-in code shouldn't ship these.
# Leading slash anchors to repo root so `app/src/app/pages/results/`
# (a frontend page) isn't swept up.
/results/
/SWE-bench/
/evomas/config/loaded/
/evomas/logs/

swebench_instances.jsonl
requirements.txt
# Reproduction-notebook artefacts that land at the repo root when
# the notebook is executed there (per-run folder, ad-hoc .ipynb copies,
# user-imported SWE-bench-style instance JSONLs).
/notebooks/
/notebook-*/
/notebook-*.ipynb
/swebench_*.jsonl

# ─── Standard GitHub Python .gitignore ───────────────────────────────────────
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

