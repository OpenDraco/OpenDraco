# Notebooks under experiments/ and notebooks/ are generated artefacts
# from the EvoMas inference pipeline, not hand-maintained source.
# Mark them as `linguist-generated` so GitHub's language detector
# excludes them from the repo's language statistics — otherwise the
# Jupyter Notebook bytes from 20+ run logs swamp the actual Python
# source and the language bar shows 90%+ "Jupyter Notebook".
experiments/**/*.ipynb linguist-generated=true
notebooks/**/*.ipynb   linguist-generated=true
