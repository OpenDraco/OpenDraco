# API server configuration. Copy to `.env` to override defaults.
# Read by:
#   - scripts/start_api.ps1   (host/port for uvicorn)
#   - api/server.py   (load_dotenv → os.environ)

# Bind address. Use 0.0.0.0 to expose on the LAN, 127.0.0.1 for local-only.
API_HOST=0.0.0.0

# TCP port the FastAPI server listens on.
# If you change this, also update the frontend's BASE URL in
# app/src/app/services/api.service.ts (currently hardcoded to :8000).
API_PORT=8000

# Results root for predictions + evaluations (mirror of the same key in
# evomas/.env). Relative values resolve against the repo root, so
# `results` and `<repo>/results` mean the same thing. `evomas/.env` is
# loaded first; values here override that file — useful when you want
# a separate results folder per environment (e.g. one for ad-hoc
# inference runs, another for an integration-test matrix). Default if
# unset everywhere: <repo root>/results.
# RESULTS_DIR="results"
