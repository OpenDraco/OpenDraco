# EvoMas runtime environment.
# Copy to `.env` and fill in your own values.

# LLM provider routing is per-agent via the `model` field's prefix in the
# JSON config: `ollama/<id>` | `gemini/<id>` | `openai/<id>` (LiteLLM-style).
# Each provider reads its credentials from the env vars below.

# Ollama HTTP endpoint used by every `ollama/*` agent.
# Default if unset: http://localhost:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Required only when at least one agent targets `gemini/*`.
# Get a key from https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=""

# Required only when at least one agent targets `openai/*`.
# Get a key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=""

# Optional: override the OpenAI endpoint -- useful for Azure OpenAI,
# OpenRouter, or a local LiteLLM proxy. Leave unset to hit the canonical
# api.openai.com endpoint.
# OPENAI_BASE_URL=""

# Optional: Weights & Biases API key for `evomas.utils.weave_init`.
# Only required if you call `init_weave()` (currently disabled in
# `scripts/generate_evomas_predictions.py`). Leave blank to skip W&B init.
# WANDB_API_KEY=""

# Optional: where predictions + evaluations are written. Relative values are
# resolved against the repo root, so `results` and `<repo>/results` mean the
# same thing. Default if unset: <repo root>/results.
# RESULTS_DIR="results"

# Optional: per-node revisit budget for the LangGraph runtime. The total
# super-step budget passed as `recursion_limit` is computed as
# `EVOMAS_GRAPH_MAX_REVISITS * num_agents_in_config`, so each node may
# participate in at most this many super-steps before LangGraph raises
# `GraphRecursionError`. Cycles in the config topology are allowed and
# bounded by this knob. Clamped to >= 1. Default if unset: 2.
# EVOMAS_GRAPH_MAX_REVISITS="2"

# Required for `evomas run evaluation --remote`: API key for the hosted
# SWE-bench leaderboards (https://www.swebench.com/sb-cli/). Generate
# one with `sb-cli gen-api-key your@email.com`, verify the code mailed
# to you with `sb-cli verify-api-key <code>`, then paste the key here.
# Local evaluation (--local) doesn't need this.
# SWEBENCH_API_KEY=""

# Local evaluation (`evomas run evaluation --local`, the default) runs the
# official SWE-bench Docker harness, which is NOT a pip dependency of EvoMas.
# Clone the SWE-bench repo and install it into its own venv:
#   <SWEBENCH_DIR>/        <- the SWE-bench repo clone
#   <SWEBENCH_DIR>/venv/   <- venv created with `pip install -e .`
# SWEBENCH_DIR defaults to <repo root>/SWE-bench. Set it to use a clone kept
# elsewhere; a relative value resolves against the EvoMas repo root.
# On Windows the harness is POSIX-only and runs through WSL, so create that
# venv inside WSL (a Linux venv). Not needed for inference-only or `--remote`.
# SWEBENCH_DIR="SWE-bench"
