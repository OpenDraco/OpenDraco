{
  "id": "experepair_star",
  "description": "ExpeRepair centralized star: EvoMas Router hub iterates with agent_search (Locator), PatchAgent (Patcher), and TestAgent (Bug reproduction); Review is the terminal sink. Workers are sourced from the ExpeRepair catalog; the hub uses EvoMas's built-in Router because ExpeRepair ships no native dispatcher.",
  "entry": "hub",
  "end": "reviewer",
  "edges": [
    {
      "from": "hub",
      "to": "search"
    },
    {
      "from": "search",
      "to": "hub"
    },
    {
      "from": "hub",
      "to": "patcher"
    },
    {
      "from": "patcher",
      "to": "hub"
    },
    {
      "from": "hub",
      "to": "tester"
    },
    {
      "from": "tester",
      "to": "hub"
    },
    {
      "from": "hub",
      "to": "reviewer"
    }
  ],
  "agents": {
    "hub": {
      "class": "Router",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 2048,
      "stream": true,
      "temperature": 0,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 1024,
      "stop": [],
      "max_iters": 1,
      "prompts": {
        "system": "You dispatch the next worker in an ExpeRepair-flavoured SWE-bench pipeline. Critical path: search (agent_search — Locator) -> patcher (PatchAgent) -> reviewer (Review — terminal). `tester` (TestAgent — Bug reproduction) is an optional helper and is never selected here. Answer with EXACTLY ONE word.",
        "user": "Apply these rules IN ORDER. Stop at the first rule that matches.\n\n1. If `search` output is EMPTY -> answer: search\n2. If `patcher` output is EMPTY -> answer: patcher\n3. Otherwise -> answer: reviewer\n\n--- pipeline state (empty between `<<<` and `>>>` means that worker hasn't run yet) ---\nsearch output:   <<<{search}>>>\npatcher output:  <<<{patcher}>>>\ntester output:   <<<{tester}>>>\n--- end state ---\n\nAnswer with one word from: search, patcher, reviewer."
      }
    },
    "search": {
      "class": "Locator",
      "variant": "ExpeRepair:agent_search",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 8192,
      "stream": true,
      "temperature": 0.2,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 512,
      "stop": [
        "</files>"
      ],
      "max_iters": 6,
      "prompts": {}
    },
    "patcher": {
      "class": "Patcher",
      "variant": "ExpeRepair:PatchAgent",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 16384,
      "stream": true,
      "temperature": 0,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 2048,
      "stop": [
        "</patch>"
      ],
      "max_iters": 12,
      "fallback": {
        "enabled": true,
        "guarantee_change": true
      },
      "prompts": {}
    },
    "tester": {
      "class": "Bug reproduction",
      "variant": "ExpeRepair:TestAgent",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 8192,
      "stream": true,
      "temperature": 0.2,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 1024,
      "stop": [],
      "max_iters": 6
    },
    "reviewer": {
      "class": "Reviewer",
      "variant": "ExpeRepair:Review",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 4096,
      "stream": true,
      "temperature": 0,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 1024,
      "stop": [
        "</review>"
      ],
      "max_iters": 6
    }
  }
}
